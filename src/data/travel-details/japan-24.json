        },
        {
          "id": "text-mq95v5lw",
          "type": "text",
          "text": "My foray into some mild harajuku-esque fashion, and the most painful shoes ever...Depicted here: me after a day of shopping, visiting the Shibuya tower.",
          "tone": "annotation",
          "fontSize": {
            "large": 14,
            "medium": 13,
            "small": 12
          },
          "layout": {
            "large": {
              "x": 39.25,
              "y": 1865,
